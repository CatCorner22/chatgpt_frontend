# Optional. Leave these blank to use the local studio, saved designs, and exports.
# Only the public project URL and publishable key belong in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# For server-side cloud features, use the same backend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Never prefix private server keys with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
FOCUS_SIGNING_KEY=

# Paid AI remains paused in src/lib/ai-policy.ts. Supplying a key does not enable it.
AI_PROVIDER=lovable
LOVABLE_API_KEY=
