{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["types.ts", "schemas.ts", "index.ts", "data/**/*.ts", "logic/**/*.ts", "page-checks/**/*.ts", "blind-test/**/*.ts"],
  "exclude": ["node_modules", "tests"]
}
